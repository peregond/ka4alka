<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CaptureReleaseScreenshot</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Kachalka">
      <HintPath>$(ReleaseDirectory)/Kachalka.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireReleasedApplication" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ReleaseDirectory)/Kachalka.dll')" Text="Set ReleaseDirectory to the expanded, verified public 0.39.0 application." />
  </Target>
</Project>
