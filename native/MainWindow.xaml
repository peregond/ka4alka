<Window x:Class="Kachalka.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Качалка" Width="1220" Height="850" MinWidth="360" MinHeight="300" WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Geometry x:Key="IconMovies">M3,5 L21,5 21,21 3,21 Z M3,10 L21,10 M7,5 L11,10 M14,5 L18,10</Geometry>
  <Geometry x:Key="IconSeries">M3,7 L21,7 21,20 3,20 Z M8,3 L12,7 16,3</Geometry>
  <Geometry x:Key="IconDownload">M12,3 L12,16 M7,11 L12,16 17,11 M4,17 L4,21 20,21 20,17</Geometry>
  <Geometry x:Key="IconSettings">M4,7 L20,7 M4,17 L20,17 M8,4 L8,10 M16,14 L16,20</Geometry>
  <Geometry x:Key="IconSearch">M10,3 A7,7 0 1 1 9.99,3 M15,15 L21,21</Geometry>
  <Geometry x:Key="IconPlus">M12,4 L12,20 M4,12 L20,12</Geometry>
  <Geometry x:Key="IconHeart">M12,21 C9,18 3,14 3,8 C3,2 10,2 12,7 C14,2 21,2 21,8 C21,14 15,18 12,21 Z</Geometry>
  <Geometry x:Key="IconHeartFilled">M12,21 C9,18 3,14 3,8 C3,2 10,2 12,7 C14,2 21,2 21,8 C21,14 15,18 12,21 Z</Geometry>

  <Geometry x:Key="IconTheme">M12,3 A9,9 0 1 1 11.99,3 M12,3 L12,21</Geometry>
  <Geometry x:Key="IconBack">M20,12 L4,12 M10,6 L4,12 10,18</Geometry>
  <Geometry x:Key="IconRefresh">M20,8 A8,8 0 1 0 20,16 M20,3 L20,8 15,8</Geometry>
  <Geometry x:Key="IconChevron">M9,5 L16,12 9,19</Geometry>
  <Geometry x:Key="IconFilter">M4,6 L20,6 M7,12 L17,12 M10,18 L14,18</Geometry>
  <Geometry x:Key="IconPlay">M7,4 L20,12 7,20 Z</Geometry>
  <Geometry x:Key="IconPause">M8,4 L8,20 M16,4 L16,20</Geometry>
  <Geometry x:Key="IconInfo">M12,3 A9,9 0 1 1 11.99,3 M12,10 L12,17 M12,7 L12,7.1</Geometry>
  <Geometry x:Key="IconFolder">M3,6 L10,6 12,8 21,8 21,20 3,20 Z</Geometry>
  <Geometry x:Key="IconMore">M5,11 A1,1 0 1 1 4.99,11 M12,11 A1,1 0 1 1 11.99,11 M19,11 A1,1 0 1 1 18.99,11</Geometry>
  <Geometry x:Key="IconQueueRemove">M3,5 L16,5 M3,11 L12,11 M3,17 L12,17 M16,15 L22,21 M22,15 L16,21</Geometry>
  <Geometry x:Key="IconTrash">M4,6 L20,6 M9,3 L15,3 15,6 M6,6 L7,21 17,21 18,6 M10,10 L10,17 M14,10 L14,17</Geometry>
  <Geometry x:Key="IconFile">M5,3 L14,3 20,9 20,21 5,21 Z M14,3 L14,9 20,9 M8,13 L17,13 M8,17 L15,17</Geometry>
  <Style x:Key="DownloadIconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
   <Setter Property="Width" Value="29"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3,0,0,0"/>
  </Style>
  <DataTemplate x:Key="BroadcastRow"><Border Padding="0,12" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Слушать / смотреть" Tag="{Binding}" Click="OpenBroadcast"/><Button Content="Сайт" Tag="{Binding}" Click="OpenBroadcastSite"/></StackPanel><StackPanel><TextBlock Text="{Binding Name}" FontSize="16"/><TextBlock Text="{Binding Source}" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></DockPanel></Border></DataTemplate>
  <DataTemplate x:Key="SourceRow"><Border Padding="0,12" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1"><DockPanel><Image Width="65" Height="85" Margin="0,0,16,0" Loaded="SourceCover" DataContextChanged="SourceCoverChanged" Stretch="Uniform" DockPanel.Dock="Left"/><StackPanel DockPanel.Dock="Right"><Button Content="Скачать" Tag="{Binding}" Click="SourceDownload"/><Button Content="Страница" Tag="{Binding}" Click="SourcePage"/></StackPanel><StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="16"/><TextBlock Text="{Binding Source}" Foreground="{DynamicResource Muted}" Margin="0,6"/></StackPanel></DockPanel></Border></DataTemplate>
  <DataTemplate x:Key="MediaRow">
   <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
    <Button Click="OpenCard" Tag="{Binding}" Style="{StaticResource PosterButton}" Padding="5" Margin="0,0,9,18" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
     <StackPanel>
      <Border Background="{Binding Cover}" SizeChanged="PosterResized" CornerRadius="13" ClipToBounds="True"><Image Loaded="SourceCover" DataContextChanged="SourceCoverChanged" Stretch="Uniform"/></Border>
      <TextBlock Text="{Binding Title}" Margin="1,11,1,2" Height="37" FontSize="13" LineHeight="18" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
      <TextBlock Text="{Binding Subtitle}" Margin="1,0,0,8" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal">
       <Border CornerRadius="5" Padding="6,3" Margin="0,0,5,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Selected}"/><Style.Triggers><DataTrigger Binding="{Binding KpAvailable}" Value="False"><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding KpDisplay}" FontSize="10" FontWeight="SemiBold" ToolTip="Оценка Кинопоиска"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding KpAvailable}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
       <Border CornerRadius="5" Padding="6,3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Selected}"/><Style.Triggers><DataTrigger Binding="{Binding ImdbAvailable}" Value="False"><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ImdbDisplay}" FontSize="10" FontWeight="SemiBold" ToolTip="Оценка IMDb"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding ImdbAvailable}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
      </StackPanel>
     </StackPanel>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </DataTemplate>
  <DataTemplate x:Key="DownloadRow">
   <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,0,8,6">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="52" Height="78" CornerRadius="7" Background="{DynamicResource Selected}" SizeChanged="PosterResized" ClipToBounds="True" VerticalAlignment="Top">
      <Grid><Path Data="{StaticResource IconMovies}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Width="22" Height="22" Stretch="Uniform" Opacity="0.65"/><Image Loaded="SourceCover" DataContextChanged="SourceCoverChanged" Stretch="UniformToFill"/></Grid>
     </Border>
     <Grid Grid.Column="1" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CompletionLabel}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="8,2,0,0"/><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel>
      <TextBlock Grid.Row="1" Text="{Binding Stats}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Stats}" Margin="0,3,0,0"/>
      <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding Indeterminate}" Height="4" Margin="0,6,0,4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Edge}" BorderThickness="0"/>
      <DockPanel Grid.Row="3" VerticalAlignment="Bottom" LastChildFill="True">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Button Style="{StaticResource DownloadIconButton}" Tag="{Binding}" Click="ToggleDownload" ToolTip="{Binding Action}" AutomationProperties.Name="{Binding Action}"><Path Stroke="{DynamicResource Accent}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="{StaticResource IconPause}"/><Style.Triggers><DataTrigger Binding="{Binding Paused}" Value="True"><Setter Property="Data" Value="{StaticResource IconPlay}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
        <Button Style="{StaticResource DownloadIconButton}" Tag="{Binding}" Click="DownloadDetails" ToolTip="Подробнее: файлы и серии" AutomationProperties.Name="Подробнее"><Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"/></Button>
        <Button Style="{StaticResource DownloadIconButton}" Tag="{Binding}" Click="OpenFolder" ToolTip="{Binding Folder}" AutomationProperties.Name="Открыть папку"><Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform"/></Button>
        <Button Style="{StaticResource DownloadIconButton}" Tag="{Binding}" Click="DownloadActions" ToolTip="Действия загрузки" AutomationProperties.Name="Действия загрузки"><Path Data="{StaticResource IconMore}" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" Width="15" Height="3" Stretch="Uniform"/></Button>
       </StackPanel>
       <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}"/>
      </DockPanel>
     </Grid>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid x:Name="RootGrid" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="206"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="FilterColumn" Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="SidePanel" Grid.RowSpan="3" Background="{DynamicResource Sidebar}" CornerRadius="22" Padding="12" Margin="0,0,24,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="Brand" Orientation="Horizontal" Margin="8,10,0,35"><Border Width="32" Height="32" CornerRadius="11" Background="{DynamicResource Primary}" Margin="0,0,10,0"><Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource PrimaryInk}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Width="17" Height="17"/></Border><TextBlock x:Name="BrandText" Text="Качалка" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1"><TextBlock x:Name="LibraryLabel" Text="БИБЛИОТЕКА" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="12,0,0,12"/><StackPanel x:Name="Navigation"/></StackPanel>
    <StackPanel Grid.Row="2" x:Name="SidebarFooter"><Border Height="1" Background="{DynamicResource Edge}" Margin="10,16,10,14"/><Button x:Name="SidebarUpdateButton" Style="{StaticResource PrimaryButton}" Content="Обновить" Visibility="Collapsed" Margin="0,0,0,8" MinHeight="38" ToolTip="Обновить приложение" AutomationProperties.Name="Обновить приложение" Click="SidebarUpdate"/><Button x:Name="DownloadsButton" ToolTip="Загрузки" AutomationProperties.Name="Загрузки" Style="{StaticResource NavButton}" HorizontalContentAlignment="Left" Click="ShowDownloads"/><Button x:Name="SettingsButton" ToolTip="Настройки" AutomationProperties.Name="Настройки" Style="{StaticResource NavButton}" HorizontalContentAlignment="Left" Click="Settings"/></StackPanel>
   </Grid>
  </Border>
  <Grid x:Name="HeaderArea" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="ContextLabel" Text="Твоя медиатека" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>
   <Grid x:Name="SearchBar" Height="44" Margin="0,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" Padding="42,8,40,8" ToolTip="Поиск фильма или сериала · Ctrl+K" AutomationProperties.Name="Поиск" TextChanged="SearchChanged" KeyDown="SearchKeyDown"/><Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Left" Margin="15,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Найти фильм или сериал" Margin="42,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button x:Name="ClearSearchButton" Content="×" FontSize="18" Width="30" Height="30" Margin="0,0,8,0" Padding="0" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск" Click="ClearSearch" Visibility="Collapsed"/></Grid><Button Grid.Column="1" Content="Поиск" AutomationProperties.Name="Начать общий поиск" Margin="6,0,0,0" Padding="10,6" Click="SubmitSearch"/></Grid>
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AddTorrentButton" ToolTip="Добавить торрент" AutomationProperties.Name="Добавить торрент" Click="AddTorrent" Margin="0,0,10,0"/><Button x:Name="ThemeButton" Style="{StaticResource QuietButton}" Width="38" Height="38" Padding="10" Margin="0" ToolTip="Переключить тему" AutomationProperties.Name="Переключить тему" Click="ToggleTheme"><Path Data="{StaticResource IconTheme}" Stroke="{DynamicResource Text}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"/></Button></StackPanel>
  </Grid>
  <Grid x:Name="CenterRegion" Grid.Column="1" Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="PageHeader"/>
   <Border x:Name="LoadingIndicator" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,8" Margin="0,0,8,10" AutomationProperties.Name="Индикатор загрузки"><StackPanel><TextBlock x:Name="LoadingLabel" Text="Загружаем страницу…" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/><ProgressBar IsIndeterminate="True" Height="5" Foreground="{DynamicResource Accent}" Background="{DynamicResource Edge}" BorderThickness="0"/></StackPanel></Border><Grid x:Name="Body" Grid.Row="2"/></Grid>
  <Border x:Name="FiltersPanel" Grid.Column="2" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="18" Padding="18" VerticalAlignment="Top"><ScrollViewer Style="{StaticResource PageScroll}" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="FilterControls"/></ScrollViewer></Border>
  <TextBlock x:Name="Status" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="" Foreground="{DynamicResource Muted}" FontSize="11" Margin="5,8,0,0" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Window>
