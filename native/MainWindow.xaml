  <Grid x:Name="HeaderArea" Grid.Column="1" Margin="32,42,32,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="ContextLabel" Grid.Column="1" Text="{local:Tr Text='Твоя медиатека'}" FontSize="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed"/>
   <Button x:Name="BackButton" Style="{StaticResource IconButton}" Width="48" Height="48" Margin="0,0,12,0" Visibility="Collapsed" Click="HeaderBack" ToolTip="{local:Tr Text='Назад'}" AutomationProperties.Name="{local:Tr Text='Назад'}"><Path Data="{StaticResource IconBack}" Stroke="{DynamicResource Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform"/></Button>
   <Grid x:Name="SearchBar" Grid.Column="1" Height="48" Margin="0,0,12,0">
    <TextBox x:Name="Search" MinHeight="48" Padding="48,0,110,0" ToolTip="{local:Tr Text='Поиск фильма или сериала · Ctrl+K'}" AutomationProperties.Name="{local:Tr Text='Поиск'}" TextChanged="SearchChanged" KeyDown="SearchKeyDown"/>
    <Path x:Name="SearchMagnifier" Data="{StaticResource IconSearch}" Stroke="{DynamicResource Subtle}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Left" Margin="16,0,0,0" IsHitTestVisible="False"/>
    <TextBlock x:Name="SearchPlaceholder" Text="{local:Tr Text='Найти фильм, сериал или человека'}" FontSize="15" TextTrimming="CharacterEllipsis" Margin="48,0,110,0" VerticalAlignment="Center" Foreground="{DynamicResource Subtle}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Border x:Name="SearchShortcutHint" BorderBrush="{DynamicResource Edge}" Background="{DynamicResource Raised}" BorderThickness="1" CornerRadius="7" Padding="7,3" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"><TextBlock Text="Ctrl K" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Muted}" FontSize="11"/></Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"><Button x:Name="ClearSearchButton" Style="{StaticResource QuietButton}" Width="30" Height="36" MinHeight="0" Padding="0" Margin="0,0,2,0" ToolTip="{local:Tr Text='Очистить поиск'}" AutomationProperties.Name="{local:Tr Text='Очистить поиск'}" Click="ClearSearch" Visibility="Collapsed"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/></Button><Button x:Name="SearchSubmitButton" Style="{StaticResource PrimaryButton}" Width="36" Height="36" MinHeight="0" Padding="0" Margin="0" ToolTip="{local:Tr Text='Поиск фильма или сериала'}" AutomationProperties.Name="{local:Tr Text='Начать общий поиск'}" Click="SubmitSearch" Visibility="Collapsed"><Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource PrimaryInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/></Button></StackPanel>
   </Grid>
   <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AddTorrentButton" Height="48" MinHeight="48" ToolTip="{local:Tr Text='Добавить торрент'}" AutomationProperties.Name="{local:Tr Text='Добавить торрент'}" Click="AddTorrent" Margin="0,0,12,0"/><Button x:Name="RefreshCatalogButton" Style="{StaticResource IconButton}" Width="48" Height="48" Margin="0,0,8,0" ToolTip="{local:Tr Text='Обновить каталог'}" AutomationProperties.Name="{local:Tr Text='Обновить каталог'}" Click="RefreshCatalogClicked"><Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform"/></Button><Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Width="48" Height="48" ToolTip="{local:Tr Text='Переключить тему'}" AutomationProperties.Name="{local:Tr Text='Переключить тему'}" Click="ToggleTheme"><Path x:Name="ThemeIcon" Data="{StaticResource IconMoon}" Stroke="{DynamicResource Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform"/></Button></StackPanel>
   <Border x:Name="FiltersPanel" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="Transparent" Margin="0,12,0,0" AutomationProperties.Name="{local:Tr Text='Фильтры каталога'}"><StackPanel x:Name="FilterControls"/></Border>
  </Grid>
  <Grid x:Name="CenterRegion" Grid.Column="1" Grid.Row="1" Margin="32,0,32,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="PageHeader"/>
   <Border x:Name="LoadingIndicator" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource EdgeSoft}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" AutomationProperties.Name="{local:Tr Text='Индикатор загрузки'}"><StackPanel><TextBlock x:Name="LoadingLabel" Text="{local:Tr Text='Загружаем страницу…'}" FontWeight="Medium" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/><ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0"/></StackPanel></Border><Grid x:Name="Body" Grid.Row="2"/></Grid>
  <Border x:Name="StatusToast" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="32,0,32,20" Padding="16,10,16,10" MaxWidth="560" CornerRadius="12" BorderThickness="1" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource EdgeStrong}" Visibility="Collapsed" Panel.ZIndex="50" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite">
   <TextBlock x:Name="Status" Text="" Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap"/>
  </Border>
 </Grid>
 <!-- The window has no system caption (see WindowFrame.cs): its buttons sit in the top-right corner of the app. -->
 <Border x:Name="WindowTopEdge" Height="1" VerticalAlignment="Top" Background="{DynamicResource Edge}" IsHitTestVisible="False" Visibility="Collapsed"/>
 <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
  <Button x:Name="CaptionMinimize" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="CaptionMinimizeClick" ToolTip="{local:Tr Text='Свернуть'}" AutomationProperties.Name="{local:Tr Text='Свернуть окно'}"/>
  <Button x:Name="CaptionMaximize" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="CaptionMaximizeClick" ToolTip="{local:Tr Text='Развернуть'}" AutomationProperties.Name="{local:Tr Text='Развернуть окно'}"/>
  <Button x:Name="CaptionClose" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="CaptionCloseClick" ToolTip="{local:Tr Text='Закрыть'}" AutomationProperties.Name="{local:Tr Text='Закрыть окно'}"/>
 </StackPanel>
</Grid>
</Window>
