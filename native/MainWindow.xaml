    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"><Button x:Name="ClearSearchButton" Style="{StaticResource QuietButton}" Width="30" Height="36" MinHeight="0" Padding="0" Margin="0,0,2,0" ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск" Click="ClearSearch" Visibility="Collapsed"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform"/></Button><Button x:Name="SearchSubmitButton" Style="{StaticResource PrimaryButton}" Width="36" Height="36" MinHeight="0" Padding="0" Margin="0" ToolTip="Поиск фильма или сериала" AutomationProperties.Name="Начать общий поиск" Click="SubmitSearch" Visibility="Collapsed"><Path Data="{StaticResource IconArrowRight}" Stroke="{DynamicResource PrimaryInk}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/></Button></StackPanel>
   </Grid>
   <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="AddTorrentButton" Height="48" MinHeight="48" ToolTip="Добавить торрент" AutomationProperties.Name="Добавить торрент" Click="AddTorrent" Margin="0,0,12,0"/><Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Width="48" Height="48" ToolTip="Переключить тему" AutomationProperties.Name="Переключить тему" Click="ToggleTheme"><Path x:Name="ThemeIcon" Data="{StaticResource IconMoon}" Stroke="{DynamicResource Text}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" Stretch="Uniform"/></Button></StackPanel>
   <Border x:Name="FiltersPanel" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Background="Transparent" Margin="0,12,0,0" AutomationProperties.Name="Фильтры каталога"><StackPanel x:Name="FilterControls"/></Border>
  </Grid>
  <Grid x:Name="CenterRegion" Grid.Column="1" Grid.Row="1" Margin="32,0,32,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="PageHeader"/>
   <Border x:Name="LoadingIndicator" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource EdgeSoft}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" AutomationProperties.Name="Индикатор загрузки"><StackPanel><TextBlock x:Name="LoadingLabel" Text="Загружаем страницу…" FontWeight="Medium" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/><ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource Track}" BorderThickness="0"/></StackPanel></Border><Grid x:Name="Body" Grid.Row="2"/></Grid>
  <TextBlock x:Name="Status" Grid.Row="2" Grid.Column="1" Text="" Foreground="{DynamicResource Subtle}" FontSize="11" Margin="32,6,32,8" TextTrimming="CharacterEllipsis"/>
 </Grid>
</Grid>
